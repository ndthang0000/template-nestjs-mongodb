import { IsNumber, IsOptional, IsString } from 'class-validator';
import { Create{{className}}Dto } from './create-{{fileName}}.dto';
import { ApiProperty, PartialType, ApiPropertyOptional } from '@nestjs/swagger';
import { Type } from 'class-transformer';

export class GetAll{{className}}Dto extends PartialType(Create{{className}}Dto) {
	@IsNumber()
	@IsOptional()
	@ApiProperty({ example: 1 })
	@ApiPropertyOptional()
  @Type(() => Number)
	id: number;

	@IsString()
	@IsOptional()
