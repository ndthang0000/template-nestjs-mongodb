import {
  BadRequestException,
  Body,
  Controller,
  Delete,
  Get,
  HttpException,
  HttpStatus,
  Param,
  Patch,
  Post,
  Query,
} from '@nestjs/common';
import { Types } from 'mongoose';
import { {{className}}Service } from '@service/{{fileName}}.service';
import { Create{{className}}Dto } from '@dto/{{fileName}}/create-{{fileName}}.dto';
import { Paginate{{className}}Dto } from '@dto/{{fileName}}/paginate-{{fileName}}.dto';
import { Update{{className}}Dto } from '@dto/{{fileName}}/update-{{fileName}}.dto';
import { GetAll{{className}}Dto } from '@dto/{{fileName}}/all-{{fileName}}.dto';
import { responseData, responseMessage } from '@share/interfaces/response-face';
import { ConvertSortBy, validateSortBy } from '@share/utils/sortby';
import omitKey from '@share/interfaces/omit-key.type';
import { USER_SORT_ENUM } from '../constants/user.constants';

@Controller('{{fileName}}s')
export class {{className}}Controller {
  constructor(private readonly {{variableName}}Service: {{className}}Service) { }

  @Post()
  async create(@Body() dto: Create{{className}}Dto) {
    const data = await this.{{variableName}}Service.create{{className}}(dto);
    return responseData(data, '{{className}} created successfully');
  }

  @Get('/paginate')
  async paginate(@Query() dto: Paginate{{className}}Dto) {

    const enumSort = Object.values(USER_SORT_ENUM);
    const { sortBy = 'createdAt:asc', dateFrom, dateTo } = dto;

    let filter = {};

    if (dateFrom || dateTo) {
      filter['createdAt'] = {
        ...(dateFrom && { $gte: new Date(dateFrom) }),
        ...(dateTo && { $lte: new Date(dateTo) }),
      };
    }

    const where = omitKey(dto, ['dateFrom', 'dateTo', 'sortBy', 'page', 'limit']);
    filter = Object.assign(filter, where);

    if (!validateSortBy(enumSort, sortBy)) {
      throw new HttpException('Invalid sortBy', HttpStatus.BAD_REQUEST);
    }
    const orderBy = ConvertSortBy(sortBy);

    const data = await this.{{variableName}}Service.paginate{{className}}({
      page: dto.page,
      limit: dto.limit,
      filter,
      order: orderBy,
    });
    return responseData(data);
  }

  @Get('/:id')
  async get(@Param('id') id: string) {

    if (!Types.ObjectId.isValid(id)) {
      throw new BadRequestException('Invalid ID');
    }

    const data = await this.{{variableName}}Service.get{{className}}(id);
    return responseData(data);
  }

  @Get()
  async getAll(@Query() dto: GetAll{{className}}Dto) {

    const enumSort = Object.values(USER_SORT_ENUM);
    const { sortBy = 'createdAt:asc', dateFrom, dateTo } = dto;

    let filter = {};

    if (dateFrom || dateTo) {
      filter['createdAt'] = {
        ...(dateFrom && { $gte: new Date(dateFrom) }),
        ...(dateTo && { $lte: new Date(dateTo) }),
      };
    }

    const where = omitKey(dto, ['dateFrom', 'dateTo', 'sortBy']);
    filter = Object.assign(filter, where);

    if (!validateSortBy(enumSort, sortBy)) {
      throw new HttpException('Invalid sortBy', HttpStatus.BAD_REQUEST);
    }
    const orderBy = ConvertSortBy(sortBy);

    const data = await this.{{variableName}}Service.getAll{{className}}({
      filter: filter,
      order: orderBy,
    });
    return responseData(data);
  }

  @Delete('/:id')
  async delete(@Param('id') id: string) {

    if (!Types.ObjectId.isValid(id)) {
      throw new BadRequestException('Invalid ID');
    }

    const deleted = await this.{{variableName}}Service.delete{{className}}(id);
    return responseMessage(
      deleted
        ? 'Deleted {{className}} successfully'
        : `Error! Can't delete {{className}}`,
      deleted,
      204,
    );
  }

  @Patch('/:id')
  async update(@Param('id') id: string, @Body() dto: Update{{className}}Dto) {

    if (!Types.ObjectId.isValid(id)) {
      throw new BadRequestException('Invalid ID');
    }

    const updated = await this.{{variableName}}Service.update{{className}}(id, dto);
    return responseData(updated, '{{className}} updated successfully');
  }
}
